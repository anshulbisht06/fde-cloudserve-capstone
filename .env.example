# Copy this file to .env and fill in your own values.
# .env is listed in .gitignore: never commit a real key.

# Which model provider to use: groq (default) or openrouter
LLM_PROVIDER=groq

# Groq: free tier, no card needed. Create a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

# OpenRouter (optional fallback). Free model IDs end in ":free".
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=

# Retrieval and storage (paths are relative to the project folder)
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PATH=./storage/chroma
DATABASE_PATH=./storage/decisions.db
RETRIEVAL_TOP_K=5

# Routing: placeholder until the threshold is chosen from the development data
CONFIDENCE_THRESHOLD=0.80

LOG_LEVEL=INFO
